rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
        'fullName', 'email', 'role', 'location', 'preferredLanguage',
        'accentGuidance', 'createdAt', 'updatedAt'
      ])
      && data.fullName is string
      && data.fullName.size() >= 2
      && data.email is string
      && data.location is string
      && data.preferredLanguage is string
      && data.accentGuidance is bool;
    }

    function validScan(data) {
      return data.keys().hasOnly([
        'title', 'cropType', 'customCropName', 'date', 'status', 'statusVariant', 'summary',
        'footerIcon', 'footerStatus', 'footerActionLabel', 'imageUrl',
        'cloudPhotoPath', 'firebasePhotoPath', 'photoStorageKey', 'photoScope', 'dataScope', 'assessmentStatus', 'imageSizeMb',
        'userObservations', 'updatedAt'
      ])
      && data.title is string
      && data.cropType in ['Cassava', 'Plantain', 'Maize', 'Vegetables', 'Other']
      && (data.cropType == 'Other'
        ? (!('customCropName' in data) || (
          data.customCropName is string
          && data.customCropName.size() > 0
          && data.customCropName.size() <= 80
        ))
        : !('customCropName' in data))
      && data.date is string
      && data.status == 'Observation'
      && data.statusVariant == 'amber'
      && data.summary is string
      && data.footerIcon in ['clock', 'speaker', 'check', 'alert']
      && data.footerStatus is string
      && data.footerActionLabel is string
      && data.assessmentStatus in ['pending', 'unavailable', 'failed']
      && data.dataScope == 'cloud'
      && data.updatedAt is timestamp
      && data.imageUrl is string
      && (!('cloudPhotoPath' in data) || data.cloudPhotoPath is string)
      && (!('firebasePhotoPath' in data) || data.firebasePhotoPath is string)
      && (!('photoStorageKey' in data) || data.photoStorageKey is string)
      && (!('photoScope' in data) || data.photoScope in ['cloud', 'local-only', 'missing'])
      && (!('imageSizeMb' in data) || data.imageSizeMb is number)
      && (!('userObservations' in data) || data.userObservations is string);
    }

    function validPhotoReferenceUpdate(uid, scanId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let hasFirebasePhoto = 'firebasePhotoPath' in request.resource.data;
      let hasLegacyPhoto = 'cloudPhotoPath' in request.resource.data;
      return changed.hasOnly([
          'firebasePhotoPath', 'cloudPhotoPath', 'photoStorageKey', 'photoScope', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && (!hasFirebasePhoto
          || request.resource.data.firebasePhotoPath == 'users/' + uid + '/scans/' + scanId + '/crop-photo')
        && (!hasLegacyPhoto
          || request.resource.data.cloudPhotoPath == 'users/' + uid + '/scans/' + scanId + '/photo')
        && (!('photoStorageKey' in request.resource.data) || request.resource.data.photoStorageKey is string)
        && request.resource.data.photoScope == (hasFirebasePhoto || hasLegacyPhoto ? 'cloud' : 'local-only');
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && validProfile(request.resource.data);
      allow update: if signedInAs(uid) && validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /scans/{scanId} {
        allow read: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validScan(request.resource.data)
          && (!('cloudPhotoPath' in request.resource.data)
            || request.resource.data.cloudPhotoPath == 'users/' + uid + '/scans/' + scanId + '/photo')
          && (!('firebasePhotoPath' in request.resource.data)
            || request.resource.data.firebasePhotoPath == 'users/' + uid + '/scans/' + scanId + '/crop-photo');
        allow update: if signedInAs(uid) && validPhotoReferenceUpdate(uid, scanId);
        allow delete: if signedInAs(uid);
      }
    }
  }
}
