{
  "name": "field-sense-assessment-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "season:pilot-import": "npm run build && node dist/server/src/importSeasonCalendarPilot.js",
    "season:calendar-prepare": "npm run build && node dist/server/src/prepareAfricanCropCalendar.js",
    "season:calendar-import": "npm run build && node dist/server/src/importAfricanCropCalendar.js",
    "season:zones-import": "npm run build && node dist/server/src/importSeasonZoneMapping.js",
    "season:bonn-calendar-import": "npm run build && node dist/server/src/importBonnCropCalendar.js",
    "start": "node dist/server/src/index.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/server/tests/analyzeCrop.test.js .test-dist/server/tests/assessmentApi.test.js .test-dist/server/tests/photoStorage.test.js .test-dist/server/tests/photoApi.test.js .test-dist/server/tests/supabasePhotoStore.test.js .test-dist/server/tests/seasonWeather.test.js .test-dist/server/tests/seasonSense.test.js .test-dist/server/tests/nigeriaLocation.test.js .test-dist/server/tests/seasonRecommendations.test.js .test-dist/server/tests/seasonPlanningApi.test.js .test-dist/server/tests/seasonCalendarPilot.test.js .test-dist/server/tests/seasonCalendarSource.test.js .test-dist/server/tests/cropFamilies.test.js .test-dist/server/tests/seasonPlanningDemo.test.js .test-dist/server/tests/nimetService.test.js .test-dist/server/tests/seasonRainfallApi.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
