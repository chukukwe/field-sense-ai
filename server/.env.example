# Copy to server/.env and fill values locally. Never put these values in Vite env.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.8-flash
# Keep provider keys on the server. Never add this to a VITE_* variable.
NIMET_API_KEY=your-nimet-api-key
PORT=8787
MAX_IMAGE_MB=8
ALLOWED_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# Supabase private Storage configuration. Keep the service-role key only in this server environment.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer the current Supabase Secret API key above.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=crop-photos
# Reverse geocoding for user-requested farming-zone lookup. Keep requests cached and low-volume.
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=FieldVoiceAI/1.0
# Local only: use a private file outside this repository. Deployed services should use workload identity.
GOOGLE_APPLICATION_CREDENTIALS=C:/private/path/service-account.json
